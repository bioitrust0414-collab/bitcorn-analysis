// /api/notify — 將前端傳來的警報訊息，轉發到 Telegram / LINE。
// Bot Token 等機密只存在 Vercel 專案的環境變數（Server-side），不會出現在瀏覽器裡。
//
// 需要在 Vercel 專案設定 → Environment Variables 加入（任一組即可，兩組都設也可以同時發）：
//   TELEGRAM_BOT_TOKEN         向 @BotFather 申請的 Bot Token
//   TELEGRAM_CHAT_ID           要接收通知的 chat id（可以是你自己的、或群組的）
//   LINE_CHANNEL_ACCESS_TOKEN  LINE Messaging API 的 Channel access token
//                              （LINE Notify 已於 2025/3/31 終止服務，這裡改用官方建議的替代方案）
//   LINE_USER_ID               要接收通知的 LINE userId
//
// 沒有設定的管道會直接跳過，不會噴錯。

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    res.setHeader('Allow', 'POST');
    return res.status(405).json({ ok: false, error: 'Method not allowed' });
  }

  let body = req.body;
  if (typeof body === 'string') {
    try { body = JSON.parse(body); } catch (e) { body = {}; }
  }
  const message = (body && body.message) ? String(body.message).slice(0, 1000) : null;

  if (!message) {
    return res.status(400).json({ ok: false, error: 'Missing "message" in request body' });
  }

  const results = {};

  // --- Telegram ---
  const tgToken = process.env.TELEGRAM_BOT_TOKEN;
  const tgChatId = process.env.TELEGRAM_CHAT_ID;
  if (tgToken && tgChatId) {
    try {
      const r = await fetch(`https://api.telegram.org/bot${tgToken}/sendMessage`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chat_id: tgChatId, text: message }),
      });
      results.telegram = r.ok;
    } catch (e) {
      results.telegram = false;
    }
  }

  // --- LINE Messaging API（push） ---
  const lineToken = process.env.LINE_CHANNEL_ACCESS_TOKEN;
  const lineUserId = process.env.LINE_USER_ID;
  if (lineToken && lineUserId) {
    try {
      const r = await fetch('https://api.line.me/v2/bot/message/push', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${lineToken}`,
        },
        body: JSON.stringify({
          to: lineUserId,
          messages: [{ type: 'text', text: message }],
        }),
      });
      results.line = r.ok;
    } catch (e) {
      results.line = false;
    }
  }

  return res.status(200).json({ ok: true, results });
}
